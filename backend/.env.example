# Production Database (MySQL / PostgreSQL)
DATABASE_URL=mysql+pymysql://dbuser:strong_password@127.0.0.1:3306/luta_studio

# JWT Security (Generate a strong 32+ char secret: openssl rand -hex 32)
SECRET_KEY=your-super-secret-random-32-byte-hex-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Whitelist (comma separated domains)
CORS_ORIGINS=https://lutatech.com,https://www.lutatech.com,http://localhost:3000

# App Settings
APP_NAME=Luta Tech API
VERSION=1.0.0
REMBG_MODEL=u2netp

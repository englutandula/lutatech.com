{
  "fontFamily": {
    "primary": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
  },
  "scales": {
    "h1": {
      "size": "48px",
      "lineHeight": "1.15",
      "weight": "800",
      "letterSpacing": "-0.025em"
    },
    "h2": {
      "size": "36px",
      "lineHeight": "1.2",
      "weight": "700",
      "letterSpacing": "-0.02em"
    },
    "h3": {
      "size": "28px",
      "lineHeight": "1.25",
      "weight": "700",
      "letterSpacing": "-0.015em"
    },
    "h4": {
      "size": "22px",
      "lineHeight": "1.3",
      "weight": "600",
      "letterSpacing": "-0.01em"
    },
    "body": {
      "size": "16px",
      "lineHeight": "1.5",
      "weight": "400",
      "letterSpacing": "0"
    },
    "small": {
      "size": "14px",
      "lineHeight": "1.45",
      "weight": "400",
      "letterSpacing": "0"
    },
    "caption": {
      "size": "12px",
      "lineHeight": "1.4",
      "weight": "500",
      "letterSpacing": "0.02em"
    }
  }
}